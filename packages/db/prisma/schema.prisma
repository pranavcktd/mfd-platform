generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// pg_trgm powers the data-quality module's fuzzy scheme-name matching
// (data-quality.service.ts) — declared here so a fresh database (e.g. a new
// deploy target) gets it via `prisma db push`/migrate, not just this dev DB
// where it was enabled by hand first.
datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

/// A tenant: the login account for an MFD business. Every row in every other
/// table is scoped to one Distributor via distributorId — application code
/// must filter on it in every query (row-level tenant isolation).
model Distributor {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  email             String             @unique
  passwordHash      String             @map("password_hash")
  inboundEmailAlias String             @unique @map("inbound_email_alias")
  /// Super-admin kill switch for a tenant's login — checked in
  /// AuthService.login. Distinct from ArnProfile-level RTA credentials;
  /// this blocks dashboard access entirely, not just data sync.
  isActive          Boolean            @default(true) @map("is_active")
  /// Set true on every super-admin-driven onboarding/reset (default
  /// password "Admin@123" is fixed and known) — forces a change-password
  /// prompt on next login instead of silently accepting the default
  /// forever. Cleared by AuthService.changePassword.
  mustChangePassword Boolean           @default(true) @map("must_change_password")
  createdAt         DateTime           @default(now()) @map("created_at")
  /// Soft-delete only — no cascading hard-delete exists anywhere in this
  /// schema (a real MFD has thousands of dependent rows across ~12 tables:
  /// clients, folios, transactions, SIPs, mail logs), so "Delete" in Super
  /// Admin sets this instead of actually removing anything. Hides the MFD
  /// from the default list; all data stays intact and recoverable by
  /// clearing this field directly. Also forces isActive false so login is
  /// blocked immediately, same as a manual disable.
  deletedAt         DateTime?          @map("deleted_at")

  arnProfiles       ArnProfile[]
  families          Family[]
  clients           Client[]
  folios            Folio[]
  transactions      Transaction[]
  sipRegistrations  SipRegistration[]
  ledgerEntries     RtaInsightLedger[]
  mailIngestionLogs MailIngestionLog[]
  otherAssets       OtherAsset[]
  adminAuditLogs    AdminAuditLog[]
  clientNominees    ClientNominee[]
  clientBankAccounts ClientBankAccount[]
  brokerageWithheldRows BrokerageWithheld[]
  systematicExpiryRows  RtaSystematicExpiry[]
  brokerageEarnedRows   BrokerageEarned[]

  @@map("distributors")
}

/// One ARN registration under a Distributor login. A distributor can hold a
/// parent ARN plus multiple child ARNs (sub-brokers/associates operating
/// under the same dashboard), hence the self-referential hierarchy.
model ArnProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  distributorId      String       @map("distributor_id") @db.Uuid
  distributor        Distributor  @relation(fields: [distributorId], references: [id])

  parentArnProfileId String?      @map("parent_arn_profile_id") @db.Uuid
  parentArnProfile   ArnProfile?  @relation("ArnHierarchy", fields: [parentArnProfileId], references: [id])
  childArnProfiles   ArnProfile[] @relation("ArnHierarchy")

  arnNumber          String       @unique @map("arn_number")
  arnHolderName      String       @map("arn_holder_name")
  euinNumber         String?      @map("euin_number")
  /// Marked "*" on the onboarding form, but per the actual business
  /// requirement that asterisk means NOT mandatory (opposite of the usual
  /// convention) — PAN, email, and phone are all optional, and child ARN
  /// onboarding routinely omits them entirely.
  panNumber          String?      @map("pan_number")
  displayName        String?      @map("display_name")
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  camsMailId         String?      @map("cams_mail_id")
  gstNumber          String?      @map("gst_number")

  createdAt          DateTime     @default(now()) @map("created_at")

  credentials        ExternalCredential[]
  folios             Folio[]
  mailIngestionLogs  MailIngestionLog[]
  brokerageWithheldRows BrokerageWithheld[]
  systematicExpiryRows  RtaSystematicExpiry[]
  brokerageEarnedRows   BrokerageEarned[]
  clientNominees        ClientNominee[]
  clientBankAccounts    ClientBankAccount[]

  @@index([distributorId])
  @@map("arn_profiles")
}

enum ExternalProvider {
  CAMS
  KFINTECH
  BSE
  NSE
}

/// Encrypted login vault for RTA (CAMS/KFintech) and exchange (BSE/NSE)
/// credentials, one row per ArnProfile per provider. encryptedPayload holds
/// an AES-256-GCM ciphertext of a JSON blob (login id, password, etc.) —
/// never store any of this in plaintext.
/// Deliberately NOT unique on (arnProfileId, provider) — confirmed against
/// real RTA archives (2026-07-23) that CAMS/KFintech reissue a new zip
/// password each time report scheduling is set up, so an old password can
/// still be the right one for an older archive even after a newer password
/// becomes current for live mail. Every save inserts a NEW row rather than
/// overwriting; nothing is ever deleted. Credential lookups (see
/// apps/workers/src/credential-lookup.ts) try every row for a provider,
/// newest first, until one decrypts — so password rotation is handled by
/// trying history instead of guessing which single value is "the" password.
model ExternalCredential {
  id                String           @id @default(uuid()) @db.Uuid
  arnProfileId      String           @map("arn_profile_id") @db.Uuid
  arnProfile        ArnProfile       @relation(fields: [arnProfileId], references: [id])

  provider          ExternalProvider
  encryptedPayload  String           @map("encrypted_payload")
  encryptionIv      String           @map("encryption_iv")
  encryptionAuthTag String           @map("encryption_auth_tag")

  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([arnProfileId, provider])
  @@map("external_credentials")
}

/// Cached column-mapping blueprint produced once per unrecognized report
/// layout by the LLM schema broker. Keyed by a fingerprint of the header
/// row so subsequent ingests of the same report type skip the AI call.
model ReportSchemaDefinition {
  id                String   @id @default(uuid()) @db.Uuid
  reportCode        String   @unique @map("report_code")
  category          String
  layoutFingerprint String   @unique @map("layout_fingerprint")
  definition        Json
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("report_schema_definitions")
}

/// Normalized landing zone for every RTA report row (CAMS .dbf, KFintech
/// .csv, and both RTAs' .txt formats), across all report types. Explicit
/// columns cover fields nearly every report shares; everything else lives
/// in rawStructuredPayload.
///
/// idempotencyHash = SHA256(distributorId + folioNumber + transactionDate + schemeCode + amount + units)
/// enforced unique so re-ingesting an overlapping daily delta is a no-op.
///
/// NOTE: add a GIN index on raw_structured_payload via a follow-up raw SQL
/// migration (`CREATE INDEX ... USING gin (raw_structured_payload)`) —
/// Prisma's declarative index `type` support for Postgres GIN is not used
/// here to keep the schema portable across Prisma versions.
model RtaInsightLedger {
  id                    String      @id @default(uuid()) @db.Uuid
  distributorId         String      @map("distributor_id") @db.Uuid
  distributor           Distributor @relation(fields: [distributorId], references: [id])
  rtaType               String      @map("rta_type")
  reportCode            String      @map("report_code")
  uploadedAt            DateTime    @default(now()) @map("uploaded_at")

  investorPan           String?     @map("investor_pan")
  folioNumber           String?     @map("folio_number")
  amcCode               String?     @map("amc_code")
  schemeCode            String?     @map("scheme_code")
  transactionDate        DateTime?  @map("transaction_date") @db.Date

  rawStructuredPayload  Json        @map("raw_structured_payload")
  idempotencyHash       String      @unique @map("idempotency_hash")

  /// Which real mail produced this row — unlike Transaction.mailLogId/
  /// Folio.lastBalanceMailLogId (which only get set when the downstream
  /// business logic actually applies the record, e.g. a balance report
  /// gets skipped if it's not newer than what's already stored), this is
  /// written unconditionally for EVERY report type/record parsed, making it
  /// the one reliable universal source for "what did this mail actually
  /// contain" — the Imported Data Explorer's real foundation, not a
  /// per-report-type bolt-on.
  mailLogId             String?           @map("mail_log_id") @db.Uuid
  mailLog               MailIngestionLog? @relation(fields: [mailLogId], references: [id])

  @@index([distributorId, investorPan, folioNumber])
  @@index([mailLogId])
  @@map("rta_insight_ledger")
}

/// Groups clients for the "family master" / family-wise reporting views.
model Family {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])
  familyName     String      @map("family_name")
  createdAt      DateTime    @default(now()) @map("created_at")

  clients        Client[]

  /// The one client (must already be a member via Client.familyId) who gets
  /// full visibility of every other member's details in their own client
  /// portal login — everyone else in the family only sees their own data.
  /// Nullable: a family can exist with members assigned before a head is
  /// picked.
  headClientId   String?     @unique @map("head_client_id") @db.Uuid
  headClient     Client?     @relation("FamilyHead", fields: [headClientId], references: [id])

  @@index([distributorId])
  @@map("families")
}

/// An investor. Scoped to the Distributor (not a single ArnProfile) since
/// the same client's folios can span the parent ARN and any child ARNs.
model Client {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])

  familyId       String?     @map("family_id") @db.Uuid
  family         Family?     @relation(fields: [familyId], references: [id])
  /// Opposite side of Family.headClient — structural only, no direct app
  /// logic reads this (queries go Family -> headClientId instead).
  headOfFamily   Family?     @relation("FamilyHead")

  panNumber      String?     @map("pan_number")
  name           String
  email          String?
  phone          String?
  dateOfBirth    DateTime?   @map("date_of_birth") @db.Date
  kycStatus      String?     @map("kyc_status")

  /// All of the below are real fields present in the RTA's investor-master
  /// report (CAMS WBR9 / KFintech MFSD211) that were parsed but never
  /// persisted before 2026-07-22 — captured in
  /// RtaInsightLedger.rawStructuredPayload only, never queryable.
  address1          String?  @map("address1")
  address2          String?  @map("address2")
  city              String?
  pincode           String?
  taxStatus         String?  @map("tax_status")
  /// The RTA-sourced primary bank account (CAMS WBR9 / KFintech MFSD211
  /// carry exactly one bank mandate per investor) — always shown first.
  /// Real investors can hold more than one bank account on file with the
  /// AMC in practice; since no currently-ingested report carries more than
  /// this single mandate, additional accounts are captured via the
  /// separate ClientBankAccount table instead (MFD-entered, 2026-07-25).
  bankAccountNumber String?  @map("bank_account_number")
  bankName          String?  @map("bank_name")
  bankAccounts      ClientBankAccount[]

  /// Neither RTA's investor-master export carries a nominee field at all —
  /// a genuine gap on the source side (see the schema history for
  /// address/bank above). ClientNominee (2026-07-25) replaces the old
  /// flat nomineeName/nomineeRelation pair — a folio can carry up to 3
  /// real nominees under actual SEBI nomination rules, and an RTA-fed
  /// nominee report is expected soon (see [[mfd_ingestion_engine]]), so
  /// this needed to be a real list with a source flag from the start
  /// rather than a single manually-maintained pair. No real nominee data
  /// existed in this column at migration time (confirmed: 0/612 clients),
  /// so there was nothing to carry over.
  nominees        ClientNominee[]

  /// Client-portal login (2026-07-23) — a distinct, separate auth surface
  /// from the MFD's own Distributor login (see ClientAuthGuard). Not every
  /// client has one: portalEnabled starts false, and the MFD turns it on
  /// explicitly per-client (CrmService.createPortalLogin) since it requires
  /// a real email on file to deliver the initial password to.
  passwordHash       String?  @map("password_hash")
  portalEnabled      Boolean  @default(false) @map("portal_enabled")
  mustChangePassword Boolean  @default(true) @map("must_change_password")

  /// Client-merge target (2026-07-23): when a duplicate/non-PAN client
  /// turns out to be the same real investor as another Client row, this
  /// points at the surviving row instead of deleting the merged-away one —
  /// preserves the historical Transaction/RtaInsightLedger trail, which
  /// still references the old folios (now reassigned to the target client,
  /// see CrmService.mergeClients) unambiguously. Merged-away clients are
  /// excluded from the default client list.
  mergedIntoClientId String? @map("merged_into_client_id") @db.Uuid
  mergedIntoClient   Client? @relation("ClientMerge", fields: [mergedIntoClientId], references: [id])
  mergedFromClients  Client[] @relation("ClientMerge")

  /// Set when a client is auto-created with only a PAN + name (e.g. by
  /// CasImportService when a CAS folio's PAN doesn't match any existing
  /// client) — surfaced as an MIS/CRM alert so the MFD knows to fill in
  /// contact/address/bank details manually, since none of that came from
  /// the source. Cleared by CrmService.markReviewed once the MFD has
  /// actually looked at the record.
  needsReview   Boolean  @default(false) @map("needs_review")
  reviewReason  String?  @map("review_reason")

  createdAt      DateTime    @default(now()) @map("created_at")

  folios         Folio[]
  otherAssets    OtherAsset[]

  /// Postgres treats NULLs as distinct for uniqueness purposes, so this only
  /// enforces one Client per (distributor, PAN) among clients that HAVE a
  /// PAN — non-PAN clients (see [[mfd_ingestion_engine]] CRM sync notes) can
  /// have as many rows as needed.
  @@unique([distributorId, panNumber])
  @@map("clients")
}

/// One nominee on a client's record — a real client can have more than one
/// (SEBI nomination rules allow up to 3 per folio), hence a real table
/// instead of a flat name/relation pair. `source` distinguishes MFD manual
/// entry from a future RTA-fed nominee report (not ingested yet, see
/// [[mfd_ingestion_engine]]) so the UI can show provenance once that
/// exists rather than silently mixing the two.
model ClientNominee {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])
  clientId       String      @map("client_id") @db.Uuid
  client         Client      @relation(fields: [clientId], references: [id])
  /// Only set for source="RTA" rows — which ARN/mail produced this,
  /// same traceability convention as every other RTA-ingested table.
  arnProfileId   String?           @map("arn_profile_id") @db.Uuid
  arnProfile     ArnProfile?       @relation(fields: [arnProfileId], references: [id])
  mailLogId      String?           @map("mail_log_id") @db.Uuid
  mailLog        MailIngestionLog? @relation(fields: [mailLogId], references: [id])

  nomineeName String  @map("nominee_name")
  relation    String?
  email       String?
  mobile      String?
  /// "MANUAL" (default, MFD-entered) or "RTA" — KFintech's MFSD264
  /// (Nominee Details) now feeds this; CAMS has no known equivalent report
  /// yet. Which real folio the RTA row came from, kept only for traceability
  /// (a nominee is a client-level fact once written, same as every other
  /// field on this table).
  source       String  @default("MANUAL")
  folioNumber  String? @map("folio_number")
  /// Only set for source="RTA" rows — dedup key so a re-ingested MFSD264
  /// file is a safe no-op, same pattern as every other RTA-fed table.
  idempotencyHash String? @unique @map("idempotency_hash")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("client_nominees")
}

/// An additional bank account on a client's record, beyond the single
/// RTA-sourced primary one on Client.bankAccountNumber/bankName — no
/// currently-ingested RTA report carries more than one bank mandate per
/// investor, so every row here is MFD-entered (`source` is reserved for a
/// future RTA-fed multi-account report the same way ClientNominee's is).
model ClientBankAccount {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])
  clientId       String      @map("client_id") @db.Uuid
  client         Client      @relation(fields: [clientId], references: [id])
  arnProfileId   String?           @map("arn_profile_id") @db.Uuid
  arnProfile     ArnProfile?       @relation(fields: [arnProfileId], references: [id])
  mailLogId      String?           @map("mail_log_id") @db.Uuid
  mailLog        MailIngestionLog? @relation(fields: [mailLogId], references: [id])

  bankName      String  @map("bank_name")
  accountNumber String  @map("account_number")
  ifscCode      String? @map("ifsc_code")
  branchName    String? @map("branch_name")
  /// "MANUAL" (default) or "RTA" — KFintech's MFSD263 (Registered Bank
  /// Account Details) now feeds this; CAMS has no known equivalent yet.
  source        String  @default("MANUAL")
  folioNumber   String? @map("folio_number")
  idempotencyHash String? @unique @map("idempotency_hash")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId])
  @@map("client_bank_accounts")
}

/// Periodic brokerage/trailer fee actually EARNED by the distributor — CAMS's
/// WBR6 ("My Trailer Fee Details") and KFintech's MFSD205 ("Transaction wise
/// Brokerage Report"), both built 2026-08-09 from the RTAs' own reference
/// docs, not yet verified against a real sample. Distinct from
/// BrokerageWithheld (money CAMS is holding back due to invalid KYC) and
/// from Transaction.brokerageAmount (the per-transaction incentive embedded
/// in MFSD201/WBR2 itself) — this is the RTA's own periodic fee-crediting
/// statement, with its own date range and rate per period.
model BrokerageEarned {
  id             String       @id @default(uuid()) @db.Uuid
  distributorId  String       @map("distributor_id") @db.Uuid
  distributor    Distributor  @relation(fields: [distributorId], references: [id])
  arnProfileId   String?      @map("arn_profile_id") @db.Uuid
  arnProfile     ArnProfile?  @relation(fields: [arnProfileId], references: [id])
  folioId        String?      @map("folio_id") @db.Uuid
  folio          Folio?       @relation(fields: [folioId], references: [id])
  mailLogId      String?           @map("mail_log_id") @db.Uuid
  mailLog        MailIngestionLog? @relation(fields: [mailLogId], references: [id])

  folioNumber       String    @map("folio_number")
  transactionNumber String?   @map("transaction_number")
  investorName      String?   @map("investor_name")
  investorPan       String?   @map("investor_pan")
  amcCode           String?   @map("amc_code")
  schemeCode        String?   @map("scheme_code")
  /// CAMS: P/SI/TI (Purchase/Switch In/Transfer In). KFintech: free-text transaction description.
  transactionType   String?   @map("transaction_type")
  units             Decimal?  @db.Decimal(20, 4)
  amount            Decimal?  @db.Decimal(20, 4)
  brokerageRate     Decimal?  @map("brokerage_rate") @db.Decimal(10, 4)
  brokerageAmount   Decimal?  @map("brokerage_amount") @db.Decimal(20, 4)
  /// CAMS-only: "AFE" or "TF". Null for KFintech (MFSD205 has no equivalent flag).
  feeType           String?   @map("fee_type")
  transactionDate   DateTime? @map("transaction_date") @db.Date
  feeFromDate       DateTime? @map("fee_from_date") @db.Date
  feeToDate         DateTime? @map("fee_to_date") @db.Date
  processedDate     DateTime? @map("processed_date") @db.Date
  brokerArnCode     String?   @map("broker_arn_code")

  idempotencyHash String   @unique @map("idempotency_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([distributorId])
  @@index([folioId])
  @@map("brokerage_earned")
}

/// Manually-entered non-MF asset (real estate, FD, gold, direct equity, etc.)
/// so a client's net worth isn't understated by only counting MF holdings.
/// Never RTA-sourced — this is the one CRM-adjacent module that's genuinely
/// manual-entry by design, not a future ingestion target.
model OtherAsset {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])

  clientId       String      @map("client_id") @db.Uuid
  client         Client      @relation(fields: [clientId], references: [id])

  /// One of EQUITY_SHARES / FIXED_DEPOSIT / INSURANCE / OTHER (2026-07-24
  /// dynamic-form redesign) — the frontend renders a different set of
  /// fields per type, all captured in `details` below. `value` stays the
  /// single authoritative "current value" number regardless of type (net
  /// worth / MIS reports sum this column unchanged), whether it's entered
  /// directly (FD/Insurance/Other) or computed from details (equity:
  /// quantity * currentPricePerUnit).
  assetType      String      @map("asset_type")
  description    String?
  value          Decimal     @db.Decimal(18, 2)
  asOfDate       DateTime    @map("as_of_date") @db.Date

  /// Type-specific structured fields (see AssetDetails variants in
  /// other-assets.service.ts) — e.g. for EQUITY_SHARES: stockId, quantity,
  /// buyDate, buyPricePerUnit, currentPricePerUnit. A JSON column rather
  /// than a wide sparse table of nullable columns, since each asset type
  /// needs a genuinely different field set.
  details        Json?

  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([distributorId, clientId])
  @@map("other_assets")
}

/// Global (not per-distributor) equity reference master, replacing the
/// earlier "grows organically per-distributor" EquityStockMaster
/// (2026-07-23) now that a real NSE+BSE listed-equity dataset exists
/// (2026-07-24) — seeded from admin-supplied NSE_EQUITY_List /
/// BSE_EQUITY_List files, joined on ISIN (see equity-isin-master-import
/// module). Every MFD searches the SAME master (company name / NSE symbol
/// / BSE scrip code / ISIN — the fuzzy-search spec this was built to),
/// rather than each maintaining their own list from scratch. lastClosePrice
/// /lastPriceDate come along for free from the BSE file (which is itself a
/// daily Bhavcopy-shaped export, not just a static company list) — a first
/// step toward the "nightly price update" automation described in the
/// source spec, though that automation itself isn't built yet, only this
/// one-time/periodic import.
model EquityIsinMaster {
  isin              String    @id
  companyName       String    @map("company_name")
  nseSymbol         String?   @map("nse_symbol")
  bseScripCode      String?   @map("bse_scrip_code")
  bseScripId        String?   @map("bse_scrip_id")
  isTradedOnNse     Boolean   @default(false) @map("is_traded_on_nse")
  isTradedOnBse     Boolean   @default(false) @map("is_traded_on_bse")
  /// NSE preferred by default (higher liquidity) when a stock trades on
  /// both, matching the source spec's stated priority logic.
  preferredExchange String    @map("preferred_exchange")
  lastClosePrice    Decimal?  @map("last_close_price") @db.Decimal(12, 4)
  lastPriceDate     DateTime? @map("last_price_date") @db.Date
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([companyName])
  @@index([nseSymbol])
  @@index([bseScripCode])
  @@map("equity_isin_master")
}

/// Audit trail for each Equity ISIN Master import run — same "one row per
/// run" pattern as NavSyncLog/MailIngestionLog, added because there was no
/// history of past imports at all before this (only the most recent
/// result, shown transiently in the UI and lost on refresh).
model EquityIsinImportLog {
  id             String    @id @default(uuid()) @db.Uuid
  triggeredAt    DateTime  @default(now()) @map("triggered_at")
  completedAt    DateTime? @map("completed_at")
  status         String    @default("RUNNING")
  folderPath     String    @map("folder_path")
  nseFile        String?   @map("nse_file")
  bseFile        String?   @map("bse_file")
  totalIsins     Int?      @map("total_isins")
  upserted       Int?
  nseOnly        Int?      @map("nse_only")
  bseOnly        Int?      @map("bse_only")
  tradedOnBoth   Int?      @map("traded_on_both")
  withPriceData  Int?      @map("with_price_data")
  errorMessage   String?   @map("error_message")

  @@map("equity_isin_import_logs")
}

/// One client's holding in one scheme. arnProfileId records which ARN the
/// business is booked under, for brokerage attribution.
model Folio {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])

  arnProfileId   String?     @map("arn_profile_id") @db.Uuid
  arnProfile     ArnProfile? @relation(fields: [arnProfileId], references: [id])

  clientId       String      @map("client_id") @db.Uuid
  client         Client      @relation(fields: [clientId], references: [id])

  folioNumber    String      @map("folio_number")
  amcCode        String      @map("amc_code")
  schemeCode     String      @map("scheme_code")
  openDate       DateTime?   @map("open_date") @db.Date

  /// Full scheme/plan name as sent by the RTA (CAMS's "SCHEME"/"SCH_NAME" or
  /// KFintech's "Fund Description") — real data, e.g. "Aditya Birla Sun Life
  /// Large & Mid Cap Fund - Growth-Regular Plan". amcCode/schemeCode alone
  /// are short RTA-internal codes (single letters for CAMS, ~3-char for
  /// KFintech) that mean nothing without this on their own — resolveAmcName
  /// (packages/shared/src/amc-names.ts, added 2026-07-23) derives a real
  /// AMC display name from this field for reporting, rather than showing
  /// the bare code.
  schemeName     String?     @map("scheme_name")
  /// Asset class as sent by the RTA (CAMS's "SCHEME_TYP" e.g. "Equity(S)",
  /// KFintech's "AssetType") — enables real portfolio-composition analysis
  /// without needing NAV/benchmark history.
  assetClass     String?     @map("asset_class")

  /// Latest known balance snapshot (from CAMS WBR4 / KFintech MFSD203), not
  /// a time series — only overwritten when a newer report's asOfDate is
  /// more recent than what's stored, so out-of-order ingestion can't
  /// regress current AUM with stale data. A proper valuation history table
  /// is a future "Calculated Metrics Cache" concern, not built yet.
  balanceUnits     Decimal?  @map("balance_units") @db.Decimal(18, 4)
  valuationAmount  Decimal?  @map("valuation_amount") @db.Decimal(18, 2)
  navPerUnit       Decimal?  @map("nav_per_unit") @db.Decimal(12, 4)
  balanceAsOfDate  DateTime? @map("balance_as_of_date") @db.Date

  /// Persisted fallback for a folio that has NEVER received an RTA balance
  /// report (WBR4/CLIENT_AUM/MFSD203) at all — real confirmed case: a
  /// client with a genuine lumpsum PURCHASE transaction (real units, real
  /// amount) but every balance* field above null, because no balance
  /// report has arrived for that folio yet. Replayed from transaction
  /// history (see computeFolioCurrentUnitsFromTransactions), valued at the
  /// most recent transaction's own NAV. Persisted (not just computed
  /// on-read) so raw-SQL AUM aggregates across the app (dashboard,
  /// client-list totals) can COALESCE onto it too, not just the single
  /// client-detail view. Always null once a real balance report exists —
  /// balanceUnits/valuationAmount above always win when present.
  estimatedBalanceUnits    Decimal?  @map("estimated_balance_units") @db.Decimal(18, 4)
  estimatedValuationAmount Decimal?  @map("estimated_valuation_amount") @db.Decimal(18, 2)

  /// "RTA_MAILBACK" (default, existing convention — nothing about already-
  /// ingested rows changes) or "CAS_IMPORT" (2026-07-24, Import External
  /// Data module) — a CAS-sourced folio may belong to an AMC this MFD
  /// doesn't hold an ARN for at all (arnProfileId stays null in that case),
  /// surfaced so the CRM/reports UI can visibly mark it as "not managed by
  /// you" rather than presenting it identically to a real serviced folio.
  source         String      @default("RTA_MAILBACK")

  /// "CAMS" or "KFINTECH" — which RTA actually assigned amcCode, captured
  /// at ingestion (schema-mapping.processor.ts already knows this per
  /// batch). Null for folios created before 2026-07-25 and for CAS-sourced
  /// ones. Exists because amcCode alone is NOT a safe cross-RTA key: CAMS
  /// and KFintech maintain separate, uncoordinated AMC-code systems and a
  /// given code string can mean a different AMC in each (confirmed several
  /// codes coincidentally agree, e.g. "128"=Axis in both, but that's not
  /// guaranteed generally) — resolveDisplayAmcName only trusts KFintech's
  /// real Fund-code table (packages/shared/src/kfintech-amc-codes.ts) when
  /// this field says "KFINTECH", never guessed from the code's shape.
  rtaType        String?     @map("rta_type")

  /// From CAMS WBR56 ("KYC status of Investor") — the primary holder's raw
  /// status code (e.g. "KYC OK"/"KYC Failed"), its plain-English description,
  /// and Aadhaar-linking status (e.g. "Aadhar Linked"). Per-folio, not
  /// per-client, matching the report's own scope — guardian/joint-holder
  /// statuses from the same report aren't captured (primary holder only, for
  /// now). Same "latest known snapshot, only overwritten by a newer report
  /// date" convention as the balance fields above.
  kycStatus            String?   @map("kyc_status")
  kycStatusDescription String?   @map("kyc_status_description")
  aadhaarStatus        String?   @map("aadhaar_status")
  kycReportDate         DateTime? @map("kyc_report_date") @db.Date

  /// Backfilled by matching (amcCode, lower(schemeName)) against the global
  /// SchemeMaster table (verified against real data: exact scheme-code
  /// join fails completely — Folio.schemeCode is CAMS's transaction-report
  /// PRODCODE, a different code space than WBR39's own SCH_CODE — but
  /// case-insensitive scheme-name matching hits 97.4% of real CAMS folios).
  /// Used to look up a live AMFI NAV for this folio's scheme.
  isin           String?     @map("isin")

  /// Which real mail/file most recently updated this folio's balance
  /// snapshot (CLIENT_AUM/WBR4/MFSD203) — traceability requested directly:
  /// "wherever data is showing, show which RTA file it came from." Only
  /// covers the balance snapshot, not the whole folio (a folio accumulates
  /// data from many separate emails over time — investor-master, KYC,
  /// each transaction file — a single FK can't represent "the" source for
  /// all of it). Null for folios whose balance was last updated before
  /// this field existed, and always null for CAS-imported folios (no mail
  /// exists for those).
  lastBalanceMailLogId String?           @map("last_balance_mail_log_id") @db.Uuid
  lastBalanceMailLog   MailIngestionLog? @relation(fields: [lastBalanceMailLogId], references: [id])

  createdAt      DateTime    @default(now()) @map("created_at")

  transactions      Transaction[]
  sipRegistrations  SipRegistration[]
  brokerageWithheldRows BrokerageWithheld[]
  systematicExpiryRows  RtaSystematicExpiry[]
  brokerageEarnedRows   BrokerageEarned[]

  @@unique([distributorId, amcCode, folioNumber, schemeCode])
  @@index([distributorId, clientId])
  @@map("folios")
}

/// From CAMS WBR56 ("KYC status of Investor") — real per-folio field
/// layout confirmed 2026-07-27 against live mail (see mfd_ingestion_engine
/// memory). Not yet wired into ingestion; schema only.
/// From CAMS WBR95 ("Brokerage Withheld") — real per-folio brokerage that
/// CAMS is withholding because that folio's KYC is invalid (confirmed
/// against real data: every sample row had kycStatusAtWithholding ==
/// "KYC Failed"). The three withheld-amount fields are named from CAMS's
/// own raw column abbreviations (TF/TI/UPF) since no field-layout glossary
/// exists for this report anywhere supplied so far — treat the exact
/// business meaning of each as unconfirmed, shown as reported.
model BrokerageWithheld {
  id             String       @id @default(uuid()) @db.Uuid
  distributorId  String       @map("distributor_id") @db.Uuid
  distributor    Distributor  @relation(fields: [distributorId], references: [id])
  arnProfileId   String?      @map("arn_profile_id") @db.Uuid
  arnProfile     ArnProfile?  @relation(fields: [arnProfileId], references: [id])
  folioId        String?      @map("folio_id") @db.Uuid
  folio          Folio?       @relation(fields: [folioId], references: [id])
  /// Which real RTA mail produced this row — same traceability convention as Transaction.mailLogId.
  mailLogId      String?           @map("mail_log_id") @db.Uuid
  mailLog        MailIngestionLog? @relation(fields: [mailLogId], references: [id])

  folioNumber           String    @map("folio_number")
  transactionNumber     String?   @map("transaction_number")
  investorName           String?  @map("investor_name")
  investorPan            String?  @map("investor_pan")
  amcCode                String?  @map("amc_code")
  schemeCode             String?  @map("scheme_code")
  kycStatusAtWithholding String?  @map("kyc_status_at_withholding")
  /// CAMS raw field "TF" — best-effort label "Trail Fee Withheld", unconfirmed.
  /// Precision widened past what the small real sample values suggested —
  /// a real 2026-07-27 batch hit a numeric-overflow error on the original
  /// Decimal(14,4), confirming some real rows carry far larger magnitudes.
  trailFeeWithheld              Decimal? @map("trail_fee_withheld") @db.Decimal(20, 4)
  /// CAMS raw field "TI" — meaning unconfirmed.
  transactionIncentiveWithheld  Decimal? @map("transaction_incentive_withheld") @db.Decimal(20, 4)
  /// CAMS raw field "UPF" — best-effort label "Upfront Withheld", unconfirmed.
  upfrontWithheld                Decimal? @map("upfront_withheld") @db.Decimal(20, 4)
  processedDate  DateTime? @map("processed_date") @db.Date
  reportDate     DateTime  @map("report_date") @db.Date

  idempotencyHash String   @unique @map("idempotency_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([distributorId])
  @@index([folioId])
  @@index([mailLogId])
  @@map("brokerage_withheld")
}

/// From CAMS WBR5 ("A list of SIP Investors whose plans expire shortly") —
/// the RTA's own authoritative expiring-systematic-registration list, a
/// genuine upgrade over the existing SIP Expiring report (which only
/// estimates from SipRegistration.endDate). Real sample data confirmed this
/// also covers expiring STP/switch registrations (transactionType "SO"),
/// not pure SIP alone.
model RtaSystematicExpiry {
  id             String       @id @default(uuid()) @db.Uuid
  distributorId  String       @map("distributor_id") @db.Uuid
  distributor    Distributor  @relation(fields: [distributorId], references: [id])
  arnProfileId   String?      @map("arn_profile_id") @db.Uuid
  arnProfile     ArnProfile?  @relation(fields: [arnProfileId], references: [id])
  folioId        String?      @map("folio_id") @db.Uuid
  folio          Folio?       @relation(fields: [folioId], references: [id])
  /// Which real RTA mail produced this row — same traceability convention as Transaction.mailLogId.
  mailLogId      String?           @map("mail_log_id") @db.Uuid
  mailLog        MailIngestionLog? @relation(fields: [mailLogId], references: [id])

  folioNumber     String    @map("folio_number")
  refNumber       String?   @map("ref_number")
  investorName    String?   @map("investor_name")
  schemeName      String?   @map("scheme_name")
  toSchemeName    String?   @map("to_scheme_name")
  /// Raw CAMS transaction-type code (e.g. "P" = SIP/Purchase-type
  /// systematic plan, "SO" = Switch Out / STP leg) — not run through
  /// resolveTransactionType, this report's own vocabulary is small and
  /// distinct from the transaction report's.
  transactionType String?   @map("transaction_type")
  /// Widened past Decimal(14,2) — see BrokerageWithheld's doc comment,
  /// same real-data overflow discovery applies here.
  amount          Decimal?  @db.Decimal(20, 2)
  units           Decimal?  @db.Decimal(18, 4)
  expiryDate      DateTime? @map("expiry_date") @db.Date
  taxStatus       String?   @map("tax_status")
  /// Unlike every other report ingested so far, WBR5's real field layout
  /// carries no report-generation-date field of its own (confirmed against
  /// a real sample) — nullable rather than defaulted to "now", since a
  /// fabricated processing-time value would make the idempotency hash
  /// unstable across re-runs of the same source file.
  reportDate      DateTime? @map("report_date") @db.Date

  idempotencyHash String   @unique @map("idempotency_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([distributorId])
  @@index([mailLogId])
  @@map("rta_systematic_expiry")
}

/// From CAMS WBR39 ("Scheme details") — a GLOBAL, non-tenant-scoped
/// industry-wide scheme catalog (every AMC's every scheme, not just ones
/// any particular MFD holds), confirmed 2026-07-27 against a real 7,110-row
/// export. No per-row ARN/broker code exists in this report at all, so it
/// cannot go through the normal per-tenant resolveTenantFromRecords path —
/// same "global reference table" shape as EquityIsinMaster, used to
/// backfill/enrich asset-class and ISIN data on existing Folio rows rather
/// than shown to end users directly.
model SchemeMaster {
  id                  String    @id @default(uuid()) @db.Uuid
  amcCode             String    @map("amc_code")
  amcName             String?   @map("amc_name")
  schemeCode          String    @map("scheme_code")
  schemeName          String    @map("scheme_name")
  schemeType          String?   @map("scheme_type")
  assetClass          String?   @map("asset_class")
  sebiClassification  String?   @map("sebi_classification")
  isin                String?
  planType            String?   @map("plan_type")
  sipAllowed          Boolean?  @map("sip_allowed")
  swpAllowed          Boolean?  @map("swp_allowed")
  stpAllowed          Boolean?  @map("stp_allowed")
  closeEnded          Boolean?  @map("close_ended")
  elssScheme          Boolean?  @map("elss_scheme")
  /// Real WBR39 data confirmed some schemes carry absurd sentinel-style
  /// "no real limit" values even in fields named as a minimum (e.g. a
  /// min-amount field reporting 10^13+) — widened well past what a normal
  /// minimum-investment figure would ever need, after a real batch hit a
  /// numeric-overflow error on the original Decimal(14,2)/Decimal(10,2).
  minSipAmount        Decimal?  @map("min_sip_amount") @db.Decimal(20, 2)
  minPurchaseAmount   Decimal?  @map("min_purchase_amount") @db.Decimal(20, 2)
  faceValue           Decimal?  @map("face_value") @db.Decimal(20, 2)
  parentSchemeCode    String?   @map("parent_scheme_code")
  /// AMFI's official daily NAV, matched onto this scheme via ISIN (see
  /// nav-sync.processor.ts). Real MF NAVs are published once a day, not
  /// intraday — "latest known", same "one snapshot field, not a time
  /// series" convention as Folio's own balance fields.
  latestNav           Decimal?  @map("latest_nav") @db.Decimal(20, 4)
  latestNavDate       DateTime? @map("latest_nav_date") @db.Date
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@unique([amcCode, schemeCode])
  @@index([isin])
  @@index([schemeName])
  @@map("scheme_master")
}

/// A manual data-quality correction (isin/assetClass/rtaType), remembered by
/// (amcCode, normalized scheme name) so it applies TWICE: (1) immediately to
/// every other existing folio sharing that same scheme+gap (the "fix all
/// clients with this same issue" flow in data-quality.service.ts), and (2)
/// automatically to any FUTURE folio ingested for that same scheme
/// (crm-sync.ts's upsertFolioRow consults this before falling back to
/// "still missing"), so the same scheme never needs fixing by hand twice.
/// schemeNameKey is lower(trim(scheme_name)) — computed in application code,
/// not a Postgres generated column, so the same normalization is guaranteed
/// identical between the write path and every read path.
model SchemeCorrectionRule {
  id            String   @id @default(uuid()) @db.Uuid
  amcCode       String   @map("amc_code")
  schemeNameKey String   @map("scheme_name_key")
  isin          String?
  assetClass    String?  @map("asset_class")
  rtaType       String?  @map("rta_type")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([amcCode, schemeNameKey])
  @@map("scheme_correction_rules")
}

/// A real dated NAV for one scheme (by ISIN), sourced from AMFI's
/// historical-NAV report — a genuine time series, unlike SchemeMaster's own
/// latestNav/latestNavDate ("latest known snapshot" only). Built specifically
/// to unlock equity capital-gains grandfathering (the Jan 31, 2018 NAV
/// cost-basis floor, Budget 2018), but general-purpose: any date can be
/// backfilled via nav-history-backfill.processor.ts.
model SchemeNavHistory {
  id        String   @id @default(uuid()) @db.Uuid
  isin      String
  navDate   DateTime @map("nav_date") @db.Date
  nav       Decimal  @db.Decimal(20, 4)
  createdAt DateTime @default(now()) @map("created_at")
  /// Which sync run wrote/last-confirmed this row — both nav-sync.processor.ts
  /// (DAILY) and nav-history-backfill.processor.ts (HISTORY_BACKFILL) now
  /// reattribute on every ON CONFLICT re-run, so this always reflects the
  /// most recent run that touched the row, not just its original insert.
  /// Powers the NAV Sync page's per-run "View" button.
  navSyncLogId String?     @map("nav_sync_log_id") @db.Uuid
  navSyncLog   NavSyncLog? @relation(fields: [navSyncLogId], references: [id])

  @@unique([isin, navDate])
  @@index([isin])
  @@index([navSyncLogId])
  @@map("scheme_nav_history")
}

/// Which real email domain/address each RTA sends its mail from — was a
/// hardcoded constant (mail-link-extraction.ts's SENDER_DOMAINS) before
/// this, requiring a code change + deploy if CAMS or KFintech ever
/// changed their sending address. Exactly one row per rtaType ("CAMS",
/// "KFINTECH") — mail-ingestion.processor.ts reads this table on each
/// poll cycle instead of the old constant. senderIdentifier is matched
/// via case-insensitive substring against the mail's From address, same
/// matching rule identifyRtaSender always used.
model RtaSenderConfig {
  id                String   @id @default(uuid()) @db.Uuid
  rtaType           String   @unique @map("rta_type")
  senderIdentifier  String   @map("sender_identifier")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("rta_sender_config")
}

/// Audit trail for the daily AMFI NAV sync — same "one row per run,
/// updated in place as it moves from triggered to completed/failed"
/// pattern as MailIngestionLog, so NAV sync has the same visible
/// timestamp/status/detail history the RTA mail sync already has.
model NavSyncLog {
  id               String    @id @default(uuid()) @db.Uuid
  triggeredAt      DateTime  @default(now()) @map("triggered_at")
  completedAt      DateTime? @map("completed_at")
  status           String    @default("RUNNING")
  /// "DAILY" (the scheduled AMFI NAVAll.txt pull) or "HISTORY_BACKFILL"
  /// (the on-demand date-range fetch, e.g. the 2018-01-31 grandfathering NAV).
  syncType         String    @default("DAILY") @map("sync_type")
  /// Only set for HISTORY_BACKFILL runs — the requested date range.
  fromDate         DateTime? @map("from_date") @db.Date
  toDate           DateTime? @map("to_date") @db.Date
  totalRowsInFile  Int?      @map("total_rows_in_file")
  schemesMatched   Int?      @map("schemes_matched")
  errorMessage     String?   @map("error_message")
  navHistoryRows   SchemeNavHistory[]

  @@map("nav_sync_logs")
}

/// A SIP/STP registration on a folio (CAMS WBR49 / KFintech MFSD243).
/// Immutable event record like Transaction — upserted by idempotencyHash,
/// never updated in place, since a modified/topped-up SIP shows up as its
/// own registration row in the source data rather than an edit to this one.
model SipRegistration {
  id               String      @id @default(uuid()) @db.Uuid
  distributorId    String      @map("distributor_id") @db.Uuid
  distributor      Distributor @relation(fields: [distributorId], references: [id])

  folioId          String      @map("folio_id") @db.Uuid
  folio            Folio       @relation(fields: [folioId], references: [id])

  schemeCode       String?     @map("scheme_code")
  // NOTE: missing @map("sip_amount") — inconsistent with the snake_case
  // convention everywhere else, so the real Postgres column is the
  // camelCase "sipAmount" (needs double-quoting in raw SQL). Left as-is
  // deliberately: fixing it now would need `db push` to rename the column,
  // and `db push` doesn't do safe renames — it can drop-and-recreate,
  // which would lose the real production data already loaded into this
  // table. Fix via an explicit `ALTER TABLE ... RENAME COLUMN` migration
  // if this is ever revisited, not another db push.
  sipAmount        Decimal?    @db.Decimal(18, 2)
  frequency        String?
  /// "SIP" | "STP" | "SWP" — CAMS's WBR49 doesn't label this directly, it's
  /// derived from AUT_TRNTYP (P=purchase/SIP, SO+DTP=switch-out/STP,
  /// R=redemption/SWP; confirmed 2026-08-11 against two real decrypted WBR49
  /// archives). KFintech's MFSD243 spells it out directly in its own Trtype
  /// column ("SIP"/"STP"/"SWP"). Null for rows synced before this field
  /// existed, or for any AUT_TRNTYP code not in the known set above.
  registrationType String?     @map("registration_type")
  startDate        DateTime?   @map("start_date") @db.Date
  endDate          DateTime?   @map("end_date") @db.Date
  registrationDate DateTime    @map("registration_date") @db.Date
  ceaseDate        DateTime?   @map("cease_date") @db.Date
  isActive         Boolean     @map("is_active")

  /// Which real RTA mail produced this row (WBR49/MFSD243) — same traceability convention as Transaction.mailLogId.
  mailLogId        String?           @map("mail_log_id") @db.Uuid
  mailLog          MailIngestionLog? @relation(fields: [mailLogId], references: [id])

  idempotencyHash  String      @unique @map("idempotency_hash")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([distributorId, folioId])
  @@index([mailLogId])
  @@map("sip_registrations")
}

enum MailIngestionStatus {
  NO_LINK
  ENQUEUED
  DOWNLOAD_FAILED
  DECRYPT_FAILED
  PARSE_FAILED
  COMPLETED
}

/// Admin audit trail for the mail-ingestion pipeline: one row per RTA email
/// seen, updated in place as it moves through mail-ingestion ->
/// archive-decryption -> schema-mapping (the same row id threads through
/// all three job stages as mailLogId). distributorId is nullable because
/// it isn't known until schema-mapping resolves the ARN code embedded in
/// the report data — often well after this row is first created.
model MailIngestionLog {
  id            String               @id @default(uuid()) @db.Uuid
  rtaType       String               @map("rta_type")
  fromAddress   String               @map("from_address")
  subject       String?
  /// RFC822 Message-ID header, captured at the cheap envelope-only IMAP
  /// scan (present even for rows that fail before body-parsing). Lets an
  /// admin jump straight to the exact source email in Gmail
  /// (lib/format.ts's gmailSearchLink) to manually inspect a failed mail's
  /// real content — deliberately NOT storing the raw email body/attachment
  /// itself in our own database (real client PII/financial data), per
  /// explicit user decision (2026-07-23).
  messageId     String?              @map("message_id")
  receivedAt    DateTime?            @map("received_at")
  downloadUrl   String?              @map("download_url")
  status        MailIngestionStatus
  distributorId String?              @map("distributor_id") @db.Uuid
  distributor   Distributor?         @relation(fields: [distributorId], references: [id])
  /// Which specific ARN (parent or child) this mail's data belongs to —
  /// distinct from distributorId, which only says which MFD tenant. Set
  /// from the header-match hint at mail-ingestion time (overwritten by the
  /// authoritative ARN-code-in-data match once schema-mapping resolves it).
  /// Nullable for the same reason distributorId is, plus: existing rows
  /// from before this field existed have no way to be backfilled (no raw
  /// per-record data retained on this log row to re-derive it from).
  arnProfileId  String?              @map("arn_profile_id") @db.Uuid
  arnProfile    ArnProfile?          @relation(fields: [arnProfileId], references: [id])
  reportCode    String?              @map("report_code")
  rowsInserted  Int?                 @map("rows_inserted")
  errorMessage  String?              @map("error_message")

  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  transactions          Transaction[]
  foliosLastBalanced    Folio[]
  sipRegistrations      SipRegistration[]
  brokerageWithheldRows BrokerageWithheld[]
  systematicExpiryRows  RtaSystematicExpiry[]
  insightLedgerRows     RtaInsightLedger[]
  brokerageEarnedRows   BrokerageEarned[]
  clientNominees        ClientNominee[]
  clientBankAccounts    ClientBankAccount[]

  @@index([rtaType, createdAt])
  @@index([distributorId])
  @@index([arnProfileId])
  @@map("mail_ingestion_logs")
}

/// Super-admin action trail — who did what to which distributor, and when.
/// distributorId is nullable since some actions (sync-all, schedule
/// pause/resume) aren't scoped to one tenant. No "who" beyond the shared
/// admin key exists yet (see [[mfd_platform_scaffold]] — single-operator
/// model), so actorLabel is a free-text hint, not a real user reference.
model AdminAuditLog {
  id            String       @id @default(uuid()) @db.Uuid
  action        String
  distributorId String?      @map("distributor_id") @db.Uuid
  distributor   Distributor? @relation(fields: [distributorId], references: [id])
  detail        Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([distributorId])
  @@map("admin_audit_logs")
}

/// The super-admin's own login (2026-07-23) — a friendlier username/password
/// front door in front of the pre-existing static `x-admin-key` mechanism,
/// not a replacement for it: AdminAuthService.login checks this table, and
/// on success hands back the SAME ADMIN_API_KEY value every admin/* route
/// already checks via AdminGuard — no change to any existing admin
/// endpoint's auth. The static key remains the recovery path (reset-password
/// and reset-to-default both still require it), matching how the MFD
/// onboarding default/reset password works. Single-operator model, same as
/// AdminAuditLog above — this table exists to hold ONE seeded row
/// (username "Admin"), not a multi-admin RBAC system.
model SuperAdminUser {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("super_admin_users")
}

/// A purchase/redemption/switch/SIP-installment/dividend event on a folio.
model Transaction {
  id              String      @id @default(uuid()) @db.Uuid
  distributorId   String      @map("distributor_id") @db.Uuid
  distributor     Distributor @relation(fields: [distributorId], references: [id])

  folioId         String      @map("folio_id") @db.Uuid
  folio           Folio       @relation(fields: [folioId], references: [id])

  transactionType String      @map("transaction_type")
  /// Plain-English description straight from the RTA (CAMS's TRXN_TYPE_ /
  /// KFintech's "Transaction Description") — the display-facing label,
  /// since transactionType falls back to "OTHER" for real CAMS codes our
  /// lookup table doesn't recognize (see [[mfd_ingestion_engine]]).
  transactionDescription String? @map("transaction_description")
  transactionDate DateTime    @map("transaction_date") @db.Date
  amount          Decimal?    @db.Decimal(18, 2)
  units           Decimal?    @db.Decimal(18, 4)
  navPerUnit      Decimal?    @map("nav_per_unit") @db.Decimal(12, 4)

  /// Real brokerage/commission data (CAMS's BROKPERC/BROKCOMM) — confirmed
  /// present and populated in real CAMS exports; blank in the one real
  /// KFintech sample checked (report layout has the columns, this export
  /// just didn't populate them).
  brokeragePercent Decimal?   @map("brokerage_percent") @db.Decimal(8, 4)
  brokerageAmount  Decimal?   @map("brokerage_amount") @db.Decimal(18, 2)

  idempotencyHash String      @unique @map("idempotency_hash")

  /// "RTA_MAILBACK" (default) or "CAS_IMPORT" — see Folio.source doc
  /// comment for why this distinction matters (a CAS-sourced row may
  /// belong to a folio this MFD doesn't manage at all).
  source          String      @default("RTA_MAILBACK")

  /// The RTA's own N/R mode marker (see transaction-types.ts's
  /// RTA_TRANSACTION_TYPES table) — true when this row is itself a
  /// rejection/reversal record (e.g. "ADDR" = Purchase Rejection), computed
  /// by resolveTransactionType() at ingestion but not persisted before
  /// 2026-07-25. Lets the UI flag "this transaction failed/reverted"
  /// instead of silently showing it identical to a normal one. Always
  /// false for CAS-imported rows (no RTA rejection code exists there).
  isRejection         Boolean @default(false) @map("is_rejection")
  /// Raw RTA code this row's transactionType/isRejection were resolved
  /// from (e.g. "ADDR") — kept for display/audit even when the code isn't
  /// in RTA_TRANSACTION_TYPES (isRecognizedTransactionType false).
  transactionTypeCode String? @map("transaction_type_code")

  /// CAMS WBR2's own REMARKS/REV_REMARK fields (confirmed present in a real
  /// DBF field list this session) — plain-English text for WHY a rejection/
  /// reversal happened, distinct from transactionDescription (which is just
  /// the transaction TYPE's label, e.g. "Purchase Rejection", not a reason).
  /// REV_REMARK is preferred when both are populated (more specific to a
  /// rejection than the general-purpose REMARKS field). No KFintech
  /// equivalent has been confirmed against real data — null for KFintech
  /// and CAS-imported rows, not guessed.
  rejectionReason String? @map("rejection_reason")

  /// Which real mail/file this specific transaction was ingested from —
  /// traceability requested directly ("show which RTA file this came
  /// from"). Null for rows ingested before this field existed and for
  /// CAS-imported rows (no mail exists for those).
  mailLogId       String?          @map("mail_log_id") @db.Uuid
  mailLog         MailIngestionLog? @relation(fields: [mailLogId], references: [id])

  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([distributorId, folioId, transactionDate])
  @@index([mailLogId])
  @@map("transactions")
}
