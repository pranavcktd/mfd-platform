generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A tenant: the login account for an MFD business. Every row in every other
/// table is scoped to one Distributor via distributorId — application code
/// must filter on it in every query (row-level tenant isolation).
model Distributor {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  email             String             @unique
  passwordHash      String             @map("password_hash")
  inboundEmailAlias String             @unique @map("inbound_email_alias")
  createdAt         DateTime           @default(now()) @map("created_at")

  arnProfiles       ArnProfile[]
  families          Family[]
  clients           Client[]
  folios            Folio[]
  transactions      Transaction[]
  sipRegistrations  SipRegistration[]
  ledgerEntries     RtaInsightLedger[]
  mailIngestionLogs MailIngestionLog[]
  otherAssets       OtherAsset[]

  @@map("distributors")
}

/// One ARN registration under a Distributor login. A distributor can hold a
/// parent ARN plus multiple child ARNs (sub-brokers/associates operating
/// under the same dashboard), hence the self-referential hierarchy.
model ArnProfile {
  id                 String       @id @default(uuid()) @db.Uuid
  distributorId      String       @map("distributor_id") @db.Uuid
  distributor        Distributor  @relation(fields: [distributorId], references: [id])

  parentArnProfileId String?      @map("parent_arn_profile_id") @db.Uuid
  parentArnProfile   ArnProfile?  @relation("ArnHierarchy", fields: [parentArnProfileId], references: [id])
  childArnProfiles   ArnProfile[] @relation("ArnHierarchy")

  arnNumber          String       @unique @map("arn_number")
  arnHolderName      String       @map("arn_holder_name")
  euinNumber         String?      @map("euin_number")
  /// Marked "*" on the onboarding form, but per the actual business
  /// requirement that asterisk means NOT mandatory (opposite of the usual
  /// convention) — PAN, email, and phone are all optional, and child ARN
  /// onboarding routinely omits them entirely.
  panNumber          String?      @map("pan_number")
  displayName        String?      @map("display_name")
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  camsMailId         String?      @map("cams_mail_id")
  gstNumber          String?      @map("gst_number")

  createdAt          DateTime     @default(now()) @map("created_at")

  credentials        ExternalCredential[]
  folios             Folio[]

  @@index([distributorId])
  @@map("arn_profiles")
}

enum ExternalProvider {
  CAMS
  KFINTECH
  BSE
  NSE
}

/// Encrypted login vault for RTA (CAMS/KFintech) and exchange (BSE/NSE)
/// credentials, one row per ArnProfile per provider. encryptedPayload holds
/// an AES-256-GCM ciphertext of a JSON blob (login id, password, etc.) —
/// never store any of this in plaintext.
model ExternalCredential {
  id                String           @id @default(uuid()) @db.Uuid
  arnProfileId      String           @map("arn_profile_id") @db.Uuid
  arnProfile        ArnProfile       @relation(fields: [arnProfileId], references: [id])

  provider          ExternalProvider
  encryptedPayload  String           @map("encrypted_payload")
  encryptionIv      String           @map("encryption_iv")
  encryptionAuthTag String           @map("encryption_auth_tag")

  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([arnProfileId, provider])
  @@map("external_credentials")
}

/// Cached column-mapping blueprint produced once per unrecognized report
/// layout by the LLM schema broker. Keyed by a fingerprint of the header
/// row so subsequent ingests of the same report type skip the AI call.
model ReportSchemaDefinition {
  id                String   @id @default(uuid()) @db.Uuid
  reportCode        String   @unique @map("report_code")
  category          String
  layoutFingerprint String   @unique @map("layout_fingerprint")
  definition        Json
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("report_schema_definitions")
}

/// Normalized landing zone for every RTA report row (CAMS .dbf, KFintech
/// .csv, and both RTAs' .txt formats), across all report types. Explicit
/// columns cover fields nearly every report shares; everything else lives
/// in rawStructuredPayload.
///
/// idempotencyHash = SHA256(distributorId + folioNumber + transactionDate + schemeCode + amount + units)
/// enforced unique so re-ingesting an overlapping daily delta is a no-op.
///
/// NOTE: add a GIN index on raw_structured_payload via a follow-up raw SQL
/// migration (`CREATE INDEX ... USING gin (raw_structured_payload)`) —
/// Prisma's declarative index `type` support for Postgres GIN is not used
/// here to keep the schema portable across Prisma versions.
model RtaInsightLedger {
  id                    String      @id @default(uuid()) @db.Uuid
  distributorId         String      @map("distributor_id") @db.Uuid
  distributor           Distributor @relation(fields: [distributorId], references: [id])
  rtaType               String      @map("rta_type")
  reportCode            String      @map("report_code")
  uploadedAt            DateTime    @default(now()) @map("uploaded_at")

  investorPan           String?     @map("investor_pan")
  folioNumber           String?     @map("folio_number")
  amcCode               String?     @map("amc_code")
  schemeCode            String?     @map("scheme_code")
  transactionDate        DateTime?  @map("transaction_date") @db.Date

  rawStructuredPayload  Json        @map("raw_structured_payload")
  idempotencyHash       String      @unique @map("idempotency_hash")

  @@index([distributorId, investorPan, folioNumber])
  @@map("rta_insight_ledger")
}

/// Groups clients for the "family master" / family-wise reporting views.
model Family {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])
  familyName     String      @map("family_name")
  createdAt      DateTime    @default(now()) @map("created_at")

  clients        Client[]

  @@index([distributorId])
  @@map("families")
}

/// An investor. Scoped to the Distributor (not a single ArnProfile) since
/// the same client's folios can span the parent ARN and any child ARNs.
model Client {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])

  familyId       String?     @map("family_id") @db.Uuid
  family         Family?     @relation(fields: [familyId], references: [id])

  panNumber      String?     @map("pan_number")
  name           String
  email          String?
  phone          String?
  dateOfBirth    DateTime?   @map("date_of_birth") @db.Date
  kycStatus      String?     @map("kyc_status")

  /// All of the below are real fields present in the RTA's investor-master
  /// report (CAMS WBR9 / KFintech MFSD211) that were parsed but never
  /// persisted before 2026-07-22 — captured in
  /// RtaInsightLedger.rawStructuredPayload only, never queryable. Nominee is
  /// deliberately NOT modeled here: neither RTA's investor-master export
  /// (as ingested) carries a nominee field at all — this isn't a missed
  /// mapping, the data genuinely isn't in what we receive.
  address1          String?  @map("address1")
  address2          String?  @map("address2")
  city              String?
  pincode           String?
  taxStatus         String?  @map("tax_status")
  bankAccountNumber String?  @map("bank_account_number")
  bankName          String?  @map("bank_name")

  createdAt      DateTime    @default(now()) @map("created_at")

  folios         Folio[]
  otherAssets    OtherAsset[]

  /// Postgres treats NULLs as distinct for uniqueness purposes, so this only
  /// enforces one Client per (distributor, PAN) among clients that HAVE a
  /// PAN — non-PAN clients (see [[mfd_ingestion_engine]] CRM sync notes) can
  /// have as many rows as needed.
  @@unique([distributorId, panNumber])
  @@map("clients")
}

/// Manually-entered non-MF asset (real estate, FD, gold, direct equity, etc.)
/// so a client's net worth isn't understated by only counting MF holdings.
/// Never RTA-sourced — this is the one CRM-adjacent module that's genuinely
/// manual-entry by design, not a future ingestion target.
model OtherAsset {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])

  clientId       String      @map("client_id") @db.Uuid
  client         Client      @relation(fields: [clientId], references: [id])

  assetType      String      @map("asset_type")
  description    String?
  value          Decimal     @db.Decimal(18, 2)
  asOfDate       DateTime    @map("as_of_date") @db.Date

  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([distributorId, clientId])
  @@map("other_assets")
}

/// One client's holding in one scheme. arnProfileId records which ARN the
/// business is booked under, for brokerage attribution.
model Folio {
  id             String      @id @default(uuid()) @db.Uuid
  distributorId  String      @map("distributor_id") @db.Uuid
  distributor    Distributor @relation(fields: [distributorId], references: [id])

  arnProfileId   String?     @map("arn_profile_id") @db.Uuid
  arnProfile     ArnProfile? @relation(fields: [arnProfileId], references: [id])

  clientId       String      @map("client_id") @db.Uuid
  client         Client      @relation(fields: [clientId], references: [id])

  folioNumber    String      @map("folio_number")
  amcCode        String      @map("amc_code")
  schemeCode     String      @map("scheme_code")
  openDate       DateTime?   @map("open_date") @db.Date

  /// Full scheme/plan name as sent by the RTA (CAMS's "SCHEME"/"SCH_NAME" or
  /// KFintech's "Fund Description") — real data, e.g. "Aditya Birla Sun Life
  /// Large & Mid Cap Fund - Growth-Regular Plan". amcCode/schemeCode alone
  /// are short RTA-internal codes (single letters for CAMS, ~3-char for
  /// KFintech) that mean nothing without this. Not an AMC-name lookup table
  /// — no such reference file was available, so this stores exactly what
  /// the RTA sent rather than a fabricated/guessed AMC display name.
  schemeName     String?     @map("scheme_name")
  /// Asset class as sent by the RTA (CAMS's "SCHEME_TYP" e.g. "Equity(S)",
  /// KFintech's "AssetType") — enables real portfolio-composition analysis
  /// without needing NAV/benchmark history.
  assetClass     String?     @map("asset_class")

  /// Latest known balance snapshot (from CAMS WBR4 / KFintech MFSD203), not
  /// a time series — only overwritten when a newer report's asOfDate is
  /// more recent than what's stored, so out-of-order ingestion can't
  /// regress current AUM with stale data. A proper valuation history table
  /// is a future "Calculated Metrics Cache" concern, not built yet.
  balanceUnits     Decimal?  @map("balance_units") @db.Decimal(18, 4)
  valuationAmount  Decimal?  @map("valuation_amount") @db.Decimal(18, 2)
  navPerUnit       Decimal?  @map("nav_per_unit") @db.Decimal(12, 4)
  balanceAsOfDate  DateTime? @map("balance_as_of_date") @db.Date

  createdAt      DateTime    @default(now()) @map("created_at")

  transactions      Transaction[]
  sipRegistrations  SipRegistration[]

  @@unique([distributorId, amcCode, folioNumber, schemeCode])
  @@index([distributorId, clientId])
  @@map("folios")
}

/// A SIP/STP registration on a folio (CAMS WBR49 / KFintech MFSD243).
/// Immutable event record like Transaction — upserted by idempotencyHash,
/// never updated in place, since a modified/topped-up SIP shows up as its
/// own registration row in the source data rather than an edit to this one.
model SipRegistration {
  id               String      @id @default(uuid()) @db.Uuid
  distributorId    String      @map("distributor_id") @db.Uuid
  distributor      Distributor @relation(fields: [distributorId], references: [id])

  folioId          String      @map("folio_id") @db.Uuid
  folio            Folio       @relation(fields: [folioId], references: [id])

  schemeCode       String?     @map("scheme_code")
  // NOTE: missing @map("sip_amount") — inconsistent with the snake_case
  // convention everywhere else, so the real Postgres column is the
  // camelCase "sipAmount" (needs double-quoting in raw SQL). Left as-is
  // deliberately: fixing it now would need `db push` to rename the column,
  // and `db push` doesn't do safe renames — it can drop-and-recreate,
  // which would lose the real production data already loaded into this
  // table. Fix via an explicit `ALTER TABLE ... RENAME COLUMN` migration
  // if this is ever revisited, not another db push.
  sipAmount        Decimal?    @db.Decimal(18, 2)
  frequency        String?
  startDate        DateTime?   @map("start_date") @db.Date
  endDate          DateTime?   @map("end_date") @db.Date
  registrationDate DateTime    @map("registration_date") @db.Date
  ceaseDate        DateTime?   @map("cease_date") @db.Date
  isActive         Boolean     @map("is_active")

  idempotencyHash  String      @unique @map("idempotency_hash")
  createdAt        DateTime    @default(now()) @map("created_at")

  @@index([distributorId, folioId])
  @@map("sip_registrations")
}

enum MailIngestionStatus {
  NO_LINK
  ENQUEUED
  DOWNLOAD_FAILED
  DECRYPT_FAILED
  PARSE_FAILED
  COMPLETED
}

/// Admin audit trail for the mail-ingestion pipeline: one row per RTA email
/// seen, updated in place as it moves through mail-ingestion ->
/// archive-decryption -> schema-mapping (the same row id threads through
/// all three job stages as mailLogId). distributorId is nullable because
/// it isn't known until schema-mapping resolves the ARN code embedded in
/// the report data — often well after this row is first created.
model MailIngestionLog {
  id            String               @id @default(uuid()) @db.Uuid
  rtaType       String               @map("rta_type")
  fromAddress   String               @map("from_address")
  subject       String?
  receivedAt    DateTime?            @map("received_at")
  downloadUrl   String?              @map("download_url")
  status        MailIngestionStatus
  distributorId String?              @map("distributor_id") @db.Uuid
  distributor   Distributor?         @relation(fields: [distributorId], references: [id])
  reportCode    String?              @map("report_code")
  rowsInserted  Int?                 @map("rows_inserted")
  errorMessage  String?              @map("error_message")

  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([rtaType, createdAt])
  @@index([distributorId])
  @@map("mail_ingestion_logs")
}

/// A purchase/redemption/switch/SIP-installment/dividend event on a folio.
model Transaction {
  id              String      @id @default(uuid()) @db.Uuid
  distributorId   String      @map("distributor_id") @db.Uuid
  distributor     Distributor @relation(fields: [distributorId], references: [id])

  folioId         String      @map("folio_id") @db.Uuid
  folio           Folio       @relation(fields: [folioId], references: [id])

  transactionType String      @map("transaction_type")
  /// Plain-English description straight from the RTA (CAMS's TRXN_TYPE_ /
  /// KFintech's "Transaction Description") — the display-facing label,
  /// since transactionType falls back to "OTHER" for real CAMS codes our
  /// lookup table doesn't recognize (see [[mfd_ingestion_engine]]).
  transactionDescription String? @map("transaction_description")
  transactionDate DateTime    @map("transaction_date") @db.Date
  amount          Decimal?    @db.Decimal(18, 2)
  units           Decimal?    @db.Decimal(18, 4)
  navPerUnit      Decimal?    @map("nav_per_unit") @db.Decimal(12, 4)

  /// Real brokerage/commission data (CAMS's BROKPERC/BROKCOMM) — confirmed
  /// present and populated in real CAMS exports; blank in the one real
  /// KFintech sample checked (report layout has the columns, this export
  /// just didn't populate them).
  brokeragePercent Decimal?   @map("brokerage_percent") @db.Decimal(8, 4)
  brokerageAmount  Decimal?   @map("brokerage_amount") @db.Decimal(18, 2)

  idempotencyHash String      @unique @map("idempotency_hash")
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([distributorId, folioId, transactionDate])
  @@map("transactions")
}
