{
  "name": "@mfd/workers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:bullmq --external:ioredis --external:@prisma/client",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mfd/db": "0.1.0",
    "@mfd/shared": "0.1.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "esbuild": "^0.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
