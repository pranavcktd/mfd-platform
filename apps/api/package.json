{
  "name": "@mfd/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/main.js --external:@nestjs/common --external:@nestjs/config --external:@nestjs/core --external:@nestjs/platform-express --external:@nestjs/microservices --external:@nestjs/websockets --external:@prisma/client --external:class-transformer --external:class-validator --external:reflect-metadata --external:rxjs --external:express",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mfd/db": "0.1.0",
    "@mfd/shared": "0.1.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "esbuild": "^0.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
