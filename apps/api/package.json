{
  "name": "@mfd/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --outfile=dist/main.js --external:@nestjs/common --external:@nestjs/config --external:@nestjs/core --external:@nestjs/jwt --external:@nestjs/platform-express --external:@nestjs/microservices --external:@nestjs/websockets --external:@prisma/client --external:bcryptjs --external:bullmq --external:class-transformer --external:class-validator --external:csv-parse --external:dotenv --external:ioredis --external:nodemailer --external:reflect-metadata --external:rxjs --external:express --external:multer --external:pdf-parse",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mfd/db": "0.1.0",
    "@mfd/shared": "0.1.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.4.2",
    "ioredis": "^5.4.1",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.15",
    "esbuild": "^0.23.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
