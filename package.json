{
  "name": "mfd-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @mfd/api",
    "dev:workers": "npm run dev -w @mfd/workers",
    "build": "npm run build --workspaces --if-present",
    "prisma:generate": "npm run generate -w @mfd/db",
    "prisma:migrate": "npm run migrate:dev -w @mfd/db",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@5.22.0": true,
    "esbuild@0.23.1": true
  }
}
