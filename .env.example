# Postgres
DATABASE_URL="postgresql://mfd:mfd_dev_password@localhost:5432/mfd_platform?schema=public"

# Redis (BullMQ queues + AMFI NAV cache)
REDIS_URL="redis://localhost:6379"

# Credential vault encryption (AES-256-GCM master key, 32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=""

# Inbound mail ingestion (per-tenant alias domain, e.g. inbound-ingest-<uuid>@platform.example.com)
INBOUND_MAIL_DOMAIN="platform.example.com"

# Shared backend inbox that MFDs auto-forward CAMS/KFintech mail into.
# BACKEND_GMAIL_APP_PASSWORD: Gmail Account > Security > 2-Step Verification > App Passwords
BACKEND_GMAIL_ADDRESS=""
BACKEND_GMAIL_APP_PASSWORD=""

# Mail poll schedule (cron). Default: 8am and 6pm daily.
MAIL_POLL_CRON="0 8,18 * * *"

# LLM schema broker (used only for unrecognized report layouts)
SCHEMA_BROKER_LLM_API_KEY=""

# Distributor login JWT signing secret
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=""

# Shared secret for the super-admin onboarding endpoints (POST /admin/*)
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
ADMIN_API_KEY=""

API_PORT=3000
