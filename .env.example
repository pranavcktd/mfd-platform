# Postgres
DATABASE_URL="postgresql://mfd:mfd_dev_password@localhost:5432/mfd_platform?schema=public"

# Redis (BullMQ queues + AMFI NAV cache)
REDIS_URL="redis://localhost:6379"

# Credential vault encryption (AES-256-GCM master key, 32 bytes, base64-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=""

# Inbound mail ingestion (per-tenant alias domain, e.g. inbound-ingest-<uuid>@platform.example.com)
INBOUND_MAIL_DOMAIN="platform.example.com"

# LLM schema broker (used only for unrecognized report layouts)
SCHEMA_BROKER_LLM_API_KEY=""

API_PORT=3000
